# Tests of the illusion package's component `player` (ADR 0055), in script mode:
#
#   -DMODE=build    -DSDK=<illusion-sdk.json> -DSOURCE=<game directory> -DWORK=<directory>
#       copies the game to WORK/src, configures it with the toolchain of SDK and builds it in WORK/build.
#   -DMODE=install  -DBUILD_DIR=<engine build> -DCONFIG=<config> -DWORK=<directory>
#       installs the components sdk and player to WORK/staging and moves the result to WORK/sdk.
#   -DMODE=contents -DPREFIX=<installed SDK> -DSOURCE_DIR=<engine source> -DBUILD_DIR=<engine build> -DSTAGING=<path>
#       fails if the installed SDK holds editor libraries or Dear ImGui headers, or if its package files name
#       the engine's source or build tree or the directory it was installed to.

cmake_minimum_required(VERSION 3.28)

function(require)
    foreach(variable IN LISTS ARGN)
        if(NOT DEFINED ${variable})
            message(FATAL_ERROR "PlayerSdk.cmake: ${variable} is not set")
        endif()
    endforeach()
endfunction()

# Runs a command and fails with its output when it fails.
function(run what)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output
        TIMEOUT 1500)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${what} failed (${result}):\n${output}")
    endif()
endfunction()

# Outside a developer environment, takes the environment of the toolchain's vcvars script (MSVC, clang-cl).
function(load_environment script)
    if(NOT WIN32 OR script STREQUAL "" OR DEFINED ENV{INCLUDE})
        return()
    endif()
    set(batch "${WORK}/environment.bat")
    file(WRITE "${batch}" "@echo off\r\nchcp 65001 >nul\r\ncall \"${script}\" >nul\r\nset\r\n")
    execute_process(COMMAND cmd /c "${batch}" RESULT_VARIABLE result OUTPUT_VARIABLE output ENCODING UTF8)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "${script} failed (${result})")
    endif()
    # Values hold semicolons (PATH); keep them out of the list of lines.
    string(REPLACE ";" "<semicolon>" output "${output}")
    string(REGEX MATCHALL "[^\r\n]+" lines "${output}")
    foreach(line IN LISTS lines)
        if(line MATCHES "^([^=]+)=(.*)$")
            string(REPLACE "<semicolon>" ";" value "${CMAKE_MATCH_2}")
            set(ENV{${CMAKE_MATCH_1}} "${value}")
        endif()
    endforeach()
endfunction()

require(MODE)
if(MODE STREQUAL "build")
    require(SDK SOURCE WORK)
    file(READ "${SDK}" json)
    string(JSON player GET "${json}" player)
    if(NOT player)
        message(FATAL_ERROR "${SDK} has no player component")
    endif()
    string(JSON cmake GET "${json}" cmake)
    string(JSON generator GET "${json}" generator)
    string(JSON package GET "${json}" package)
    string(JSON script GET "${json}" environmentScript)
    cmake_path(GET SDK PARENT_PATH sdk_directory)
    cmake_path(ABSOLUTE_PATH package BASE_DIRECTORY "${sdk_directory}" NORMALIZE)
    string(JSON count LENGTH "${json}" arguments)
    set(arguments "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON argument GET "${json}" arguments ${index})
            list(APPEND arguments "${argument}")
        endforeach()
    endif()

    file(REMOVE_RECURSE "${WORK}")
    file(MAKE_DIRECTORY "${WORK}")
    file(COPY "${SOURCE}/" DESTINATION "${WORK}/src")
    load_environment("${script}")
    run("configuring the game" "${cmake}" -S "${WORK}/src" -B "${WORK}/build" -G "${generator}" ${arguments}
        "-Dillusion_DIR=${package}")
    run("building the game" "${cmake}" --build "${WORK}/build")
    # A macOS game is a bundle with its data in Contents/Resources (cmake/IllusionGame.cmake).
    set(data "${WORK}/build/data")
    if(APPLE)
        set(data "${WORK}/build/sdk_game.app/Contents/Resources/data")
    endif()
    foreach(archive assets settings cache)
        if(NOT EXISTS "${data}/${archive}.illpak")
            message(FATAL_ERROR "the game build did not pack ${data}/${archive}.illpak")
        endif()
    endforeach()
elseif(MODE STREQUAL "install")
    require(BUILD_DIR CONFIG WORK)
    file(REMOVE_RECURSE "${WORK}")
    foreach(component sdk player)
        run("installing the component ${component}" "${CMAKE_COMMAND}" --install "${BUILD_DIR}" --config "${CONFIG}"
            --component ${component} --prefix "${WORK}/staging")
    endforeach()
    file(RENAME "${WORK}/staging" "${WORK}/sdk")
elseif(MODE STREQUAL "contents")
    require(PREFIX SOURCE_DIR BUILD_DIR STAGING)
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${PREFIX}" "${PREFIX}/*")
    if(NOT files)
        message(FATAL_ERROR "${PREFIX} is empty")
    endif()
    set(problems "")
    foreach(file IN LISTS files)
        string(TOLOWER "${file}" lower)
        if(lower MATCHES "(editor|imgui|implot)")
            string(APPEND problems "\n  ${file}: editor code (ADR 0030)")
        endif()
        if(file MATCHES "\\.(cmake|json)$")
            file(READ "${PREFIX}/${file}" text)
            foreach(forbidden IN ITEMS "${SOURCE_DIR}" "${BUILD_DIR}" "${STAGING}")
                file(TO_NATIVE_PATH "${forbidden}" native)
                foreach(spelling IN ITEMS "${forbidden}" "${native}")
                    string(FIND "${text}" "${spelling}" found)
                    if(NOT found EQUAL -1)
                        string(APPEND problems "\n  ${file}: names the absolute path ${spelling}")
                    endif()
                endforeach()
            endforeach()
        endif()
    endforeach()
    if(problems)
        message(FATAL_ERROR "the installed SDK ${PREFIX} is not clean:${problems}")
    endif()
else()
    message(FATAL_ERROR "PlayerSdk.cmake: unknown MODE '${MODE}'")
endif()

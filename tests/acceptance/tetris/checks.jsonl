{"check": "C5", "call": "component.get", "params": {"entity": "/Score", "type": "tetris.Score"}, "expect": {"result": {"value": {"gameOver": true, "lines": 0, "points": 0, "level": 1}}}}
{"check": "C5", "call": "scene.query", "params": {"has": ["tetris.ActivePiece"]}, "expect": {"result": {"total": 0}}}
{"check": "C5", "call": "play.stop"}
{"check": "C5", "call": "scene.query", "params": {"has": ["tetris.Cell"]}, "expect": {"result": {"total": 0}}}

{"check": "C1", "title": "Project: the manifest, the startup scene and eight materials exist", "call": "project.info", "expect": {"result": {"name": "Tetris", "startupScene": "assets:/scenes/main.scene"}}}
{"check": "C1", "call": "project.file_stat", "params": {"path": "assets:/scenes/main.scene"}, "expect": {"result": {"exists": true, "isDirectory": false}}}
{"check": "C1", "call": "asset.list", "params": {"path": "assets:/materials", "kind": "Material"}, "expect": {"result": {"assets": [{"path": "assets:/materials/frame.material"}, {"path": "assets:/materials/i.material"}, {"path": "assets:/materials/j.material"}, {"path": "assets:/materials/l.material"}, {"path": "assets:/materials/o.material"}, {"path": "assets:/materials/s.material"}, {"path": "assets:/materials/t.material"}, {"path": "assets:/materials/z.material"}]}}}
{"check": "C1", "call": "material.get", "params": {"path": "assets:/materials/t.material"}, "expect": {"result": {"value": {"material": {"baseColorFactor": [{"$approx": 0.5}, 0, {"$approx": 0.5}, 1]}}}}}
{"check": "C1", "call": "input.actions", "params": {"asset": "assets:/input/tetris.input"}, "expect": {"result": {"actions": [{"name": "tetris.move_left", "bindings": ["Key.Left", "Gamepad.DPadLeft"]}, {"name": "tetris.move_right"}, {"name": "tetris.rotate_cw"}, {"name": "tetris.soft_drop"}, {"name": "tetris.hard_drop", "type": "Button"}]}}}
{"check": "C3", "title": "Scene: one camera, a sun, a sky that resolves and a board of three walls", "call": "scene.query", "params": {"has": ["illusion.Camera"]}, "expect": {"result": {"total": 1, "entities": [{"path": "/Camera"}]}}}
{"check": "C3", "call": "scene.query", "params": {"has": ["illusion.DirectionalLight"]}, "expect": {"result": {"total": {"$oneOf": [1, 2, 3]}}}}
{"check": "C3", "call": "component.get", "params": {"entity": "/Sky", "type": "illusion.SkyLight"}, "expect": {"result": {"value": {"environment": "builtin:/sky/procedural"}}}}
{"check": "C3", "call": "hierarchy.children", "params": {"entity": "/Board"}, "expect": {"result": {"entities": [{"name": "Left wall"}, {"name": "Right wall"}, {"name": "Floor"}]}}}
{"check": "C3", "call": "scene.query", "params": {"has": ["illusion.MeshRenderer"], "under": "/Board"}, "expect": {"result": {"total": 3}}}
{"check": "C3", "call": "asset.dependencies", "params": {"path": "assets:/scenes/main.scene"}, "expect": {"result": {"dependencies": {"$contains": "assets:/materials/frame.material"}}}}
{"check": "C3", "call": "asset.info", "params": {"path": "assets:/materials/frame.material"}, "expect": {"result": {"kind": "Material", "references": {"$oneOf": [3, 4]}}}}
{"check": "C4", "title": "Persistence: after the restart the scene is unchanged and saves byte-identically", "call": "scene.info", "expect": {"result": {"path": "assets:/scenes/main.scene", "hash": "${hash}", "dirty": false, "entities": 7}}}
{"check": "C4", "call": "entity.get", "params": {"entity": "${board}"}, "expect": {"result": {"entity": {"id": "${board}", "path": "/Board"}, "children": 3}}}
{"check": "C4", "call": "component.get", "params": {"entity": "/Board/Floor", "type": "illusion.MeshRenderer"}, "expect": {"result": {"value": {"mesh": "builtin:/mesh/cube", "material": "assets:/materials/frame.material"}}}}
{"check": "C4", "call": "scene.save", "expect": {"result": {"entities": 7}}}
{"check": "C4", "call": "project.file_read", "params": {"path": "assets:/scenes/main.scene"}, "expect": {"result": {"text": "${sceneText}"}}}
{"check": "C6", "title": "Rendering: the 640x360 game view draws the board, picks it back and matches the golden image", "call": "viewport.set_aspect", "params": {"viewport": "game", "aspect": "fixed", "width": 640, "height": 360}, "requires": "gpu", "expect": {"result": {"settings": {"aspect": "fixed", "width": 640, "height": 360}}}}
{"check": "C6", "call": "viewport.screenshot", "params": {"viewport": "game"}, "requires": "gpu", "expect": {"result": {"width": 640, "height": 360}}, "image": {"golden": "golden/board.png", "channelTolerance": 8, "maxDifferent": 0.02, "notUniform": true}}
{"check": "C6", "call": "render.stats", "params": {"viewport": "game"}, "requires": "gpu", "expect": {"result": {"stats": {"frames": {"$min": 1}, "visible": {"$min": 3}}}}}
{"check": "C6", "call": "render.diagnostics", "requires": "gpu", "expect": {"result": {"available": true, "validationErrors": 0}}, "otherwise": {"result": {"available": false}}}
{"check": "C6", "call": "viewport.project", "params": {"viewport": "game", "entity": "/Board/Left wall"}, "requires": "gpu", "expect": {"result": {"x": {"$approx": [240.33, 1.0]}, "y": {"$approx": [180.0, 1.0]}, "inside": true}}}
{"check": "C6", "call": "viewport.pick", "params": {"viewport": "game", "x": 240.33, "y": 180.0}, "requires": "gpu", "expect": {"result": {"entity": {"path": "/Board/Left wall"}}}}
{"check": "C6", "call": "viewport.project", "params": {"viewport": "game", "entity": "/Board/Right wall"}, "requires": "gpu", "expect": {"result": {"x": {"$approx": [399.67, 1.0]}, "y": {"$approx": [180.0, 1.0]}, "inside": true}}}
{"check": "C6", "call": "viewport.pick", "params": {"viewport": "game", "x": 399.67, "y": 180.0}, "requires": "gpu", "expect": {"result": {"entity": {"path": "/Board/Right wall"}}}}
{"check": "C6", "call": "viewport.project", "params": {"viewport": "game", "entity": "/Board/Floor"}, "requires": "gpu", "expect": {"result": {"x": {"$approx": [320.0, 1.0]}, "y": {"$approx": [332.1, 1.0]}, "inside": true}}}
{"check": "C6", "call": "viewport.pick", "params": {"viewport": "game", "x": 320.0, "y": 332.1}, "requires": "gpu", "expect": {"result": {"entity": {"path": "/Board/Floor"}}}}
{"check": "C6", "call": "viewport.sample", "params": {"viewport": "game", "x": 240.33, "y": 180.0, "radius": 1}, "requires": "gpu", "expect": {"result": {"saturation": {"$max": 0.25}, "pixels": 9}}}
{"check": "C5", "title": "Behaviour: the Tetris module plays through input.inject and play.step", "call": "module.load", "params": {"path": "${tetrisModule}"}, "expect": {"result": {"modules": [{"name": "tetris"}]}}}
{"check": "C5", "call": "play.start", "params": {"fixedStep": true}}
{"check": "C5", "call": "component.add", "params": {"entity": "/Board", "type": "tetris.Board"}}
{"check": "C5", "call": "entity.create", "params": {"name": "Queue", "components": {"tetris.PieceQueue": {"seed": 1, "forced": "TI"}}}}
{"check": "C5", "call": "entity.create", "params": {"name": "Score", "components": {"tetris.Score": {}}}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "scene.query", "params": {"has": ["tetris.ActivePiece"]}, "capture": {"piece": "/entities/0/id"}, "expect": {"result": {"total": 1}}}
{"check": "C5", "call": "component.get", "params": {"entity": "${piece}", "type": "tetris.ActivePiece"}, "expect": {"result": {"value": {"kind": "T", "rotation": 0, "x": 3, "y": 19}}}}
{"check": "C5", "call": "scene.query", "params": {"has": ["tetris.ActiveBlock"]}, "expect": {"result": {"total": 4}}}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Left", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "component.get", "params": {"entity": "${piece}", "type": "tetris.ActivePiece"}, "expect": {"result": {"value": {"x": 0}}}}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Up", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Up", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "component.get", "params": {"entity": "${piece}", "type": "tetris.ActivePiece"}, "expect": {"result": {"value": {"rotation": 1, "x": 0}}}}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Down", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Down", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "component.get", "params": {"entity": "${piece}", "type": "tetris.ActivePiece"}, "expect": {"result": {"value": {"y": 18}}}}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Space", "down": true}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Space", "down": false}]}}
{"check": "C5", "call": "play.step"}
{"check": "C5", "call": "scene.query", "params": {"has": ["tetris.Cell"], "under": "/Board"}, "expect": {"result": {"total": 4}}}
{"check": "C5", "call": "scene.query", "params": {"has": ["tetris.ActivePiece"]}, "capture": {"piece": "/entities/0/id"}, "expect": {"result": {"total": 1}}}
{"check": "C5", "call": "component.get", "params": {"entity": "${piece}", "type": "tetris.ActivePiece"}, "expect": {"result": {"value": {"kind": "I", "rotation": 0, "x": 3, "y": 19}}}}
{"check": "C5", "call": "play.step", "params": {"steps": 50}}
{"check": "C5", "call": "component.get", "params": {"entity": "${piece}", "type": "tetris.ActivePiece"}, "expect": {"result": {"value": {"y": 18}}}}
{"check": "C5", "call": "entity.create", "params": {"parent": "/Board", "components": {"tetris.Cell": {"x": 3, "y": 18, "kind": "O"}}}}
{"check": "C5", "call": "entity.create", "params": {"parent": "/Board", "components": {"tetris.Cell": {"x": 4, "y": 18, "kind": "O"}}}}
{"check": "C5", "call": "entity.create", "params": {"parent": "/Board", "components": {"tetris.Cell": {"x": 5, "y": 18, "kind": "O"}}}}
{"check": "C5", "call": "entity.create", "params": {"parent": "/Board", "components": {"tetris.Cell": {"x": 6, "y": 18, "kind": "O"}}}}
{"check": "C5", "call": "input.inject", "params": {"keys": [{"key": "Space", "down": true}]}}

{"comment": "Rig maps and retargeting (ANIM-5d): an agent reads the rig of the showcase's Small Strider, checks how the Strider's idle clip plays on it, unmaps its hips with a sidecar override, sees the retargeting change, undoes the override and sees it come back. Replayed with the showcase project open (editor/tests/CMakeLists.txt copies it)."}
{"call": "animation.rig", "params": {"path": "assets:/models/small_strider.gltf"}, "expect": {"result": {"ref": "assets:/models/small_strider.gltf#skin/0", "generated": true, "humanoid": false, "missing": ["leftUpperArm", "leftLowerArm", "leftHand", "rightUpperArm", "rightLowerArm", "rightHand"]}}}
{"call": "animation.retarget", "params": {"clip": "assets:/models/strider.gltf#animation/idle", "skeleton": "assets:/models/small_strider.gltf#skin/0"}, "expect": {"result": {"source": "assets:/models/strider.gltf#skin/0", "retargeted": true, "reason": "", "pairedJoints": 9, "unpairedJoints": [], "heightRatio": {"$approx": 0.75}}}}
{"call": "animation.map_joint", "params": {"path": "assets:/models/small_strider.gltf", "joint": "mixamorig:Hips", "bone": ""}, "expect": {"result": {"bone": "", "sidecar": "assets:/models/small_strider.gltf.import.json", "changed": true}}}
{"call": "animation.rig", "params": {"path": "assets:/models/small_strider.gltf"}, "expect": {"result": {"missing": ["hips", "leftUpperArm", "leftLowerArm", "leftHand", "rightUpperArm", "rightLowerArm", "rightHand"]}}}
{"call": "animation.retarget", "params": {"clip": "assets:/models/strider.gltf#animation/idle", "skeleton": "assets:/models/small_strider.gltf#skin/0"}, "expect": {"result": {"retargeted": true, "pairedJoints": 8, "unpairedJoints": ["mixamorig:Hips"], "heightRatio": {"$approx": 1}}}}
{"call": "animation.map_joint", "params": {"path": "assets:/models/small_strider.gltf", "joint": "mixamorig:Hipz", "bone": "hips"}, "expect": {"error": {"message": {"$regex": ".*"}}}}
{"call": "history.undo", "params": {}}
{"call": "animation.retarget", "params": {"clip": "assets:/models/strider.gltf#animation/idle", "skeleton": "assets:/models/small_strider.gltf#skin/0"}, "expect": {"result": {"pairedJoints": 9, "unpairedJoints": [], "heightRatio": {"$approx": 0.75}}}}
{"call": "animation.retarget", "params": {"clip": "assets:/models/strider.gltf#animation/idle", "skeleton": "assets:/models/strider.gltf#skin/0"}, "expect": {"result": {"retargeted": false, "reason": "SameSkeleton"}}}

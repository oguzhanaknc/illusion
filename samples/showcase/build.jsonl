{"comment": "Builds assets:/scenes/everything.scene of the showcase project through editor commands: every saved engine Component with every field set to something other than its default (TestShowcase.cpp checks it). Replay it with illusion_ctl against a headless editor on this project (see README.md)."}
{"call": "scene.new", "params": {"discardChanges": true}}
{"call": "material.create", "params": {"path": "assets:/materials/brass.material", "value": {"material": {"name": "Brass", "baseColorFactor": [0.78, 0.57, 0.11, 1], "metallicFactor": 1, "roughnessFactor": 0.35}}, "overwrite": true}}
{"call": "entity.create", "params": {"name": "Camera", "components": {"illusion.Transform": {"position": [0, 3, 9], "rotation": [-0.1305262, 0, 0, 0.9914449], "scale": [1, 1, 1]}, "illusion.Camera": {"fovY": 0.9, "nearPlane": 0.05, "farPlane": 400, "exposure": 1.2}, "illusion.AudioListener": {}}}}
{"call": "entity.create", "params": {"name": "Map Camera", "components": {"illusion.Transform": {"position": [0, 20, 0], "rotation": [-0.7071068, 0, 0, 0.7071068]}, "illusion.Camera": {"projection": "Orthographic", "orthoHeight": 24, "priority": -1}}}}
{"call": "entity.create", "params": {"name": "Sun", "components": {"illusion.Transform": {"position": [0, 10, 0], "rotation": [-0.4226183, 0.2, 0, 0.8837]}, "illusion.DirectionalLight": {"color": [1, 0.95, 0.85], "intensity": 4, "angularDiameter": 0.02}}}}
{"call": "entity.create", "params": {"name": "Moon", "components": {"illusion.Transform": {"rotation": [0.5, 0, 0, 0.8660254]}, "illusion.DirectionalLight": {"color": [0.6, 0.7, 1], "intensity": 0.1, "castShadows": false}}}}
{"call": "entity.create", "params": {"name": "Sky", "components": {"illusion.Transform": {}, "illusion.SkyLight": {"environment": "builtin:/sky/procedural", "intensity": 0.8}, "illusion.ProceduralSky": {"zenith": [0.2, 0.4, 0.85], "horizon": [0.85, 0.9, 0.95], "ground": [0.3, 0.25, 0.2], "sunDirection": [0.4, 0.7, -0.6], "sunRadiance": [20, 18, 15], "sunAngularRadius": 0.03, "resolution": 256}}}}
{"call": "entity.create", "params": {"name": "Night Sky", "components": {"illusion.Transform": {}, "illusion.SkyLight": {"environment": "builtin:/sky/procedural", "intensity": 0.2, "background": false}}}}
{"call": "entity.set_enabled", "params": {"entity": "/Night Sky", "enabled": false}}
{"call": "entity.create", "params": {"name": "Lamp", "components": {"illusion.Transform": {"position": [3, 2.5, 1]}, "illusion.PointLight": {"color": [1, 0.7, 0.4], "intensity": 25, "range": 6}}}}
{"call": "entity.create", "params": {"name": "Ground", "components": {"illusion.Transform": {"scale": [20, 1, 20]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/plane", "material": "builtin:/material/default", "layers": 3}}}}
{"call": "entity.create", "params": {"name": "Blocks", "components": {"illusion.Transform": {"position": [-6, 0.25, -3]}, "illusion.MeshRenderer": {"mesh": "assets:/models/blocks.gltf#mesh/0", "submesh": 1, "material": "assets:/materials/brass.material", "castShadows": false}, "illusion.RigidBody": {"motionType": "Static"}, "illusion.Collider": {"shape": "Mesh", "mesh": "assets:/models/blocks.gltf", "meshIndex": 1}}}}
{"call": "entity.create", "params": {"name": "Ghost", "components": {"illusion.Transform": {"position": [6, 0.5, -3]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/sphere", "material": "builtin:/material/default", "visible": false}}}}
{"call": "entity.create", "params": {"name": "Table", "components": {"illusion.Transform": {"position": [0, 0, -4]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/cube", "material": "assets:/materials/brass.material"}}}}
{"call": "entity.create", "params": {"name": "Leg 1", "parent": "/Table", "components": {"illusion.Transform": {}, "illusion.LocalTransform": {"position": [-0.4, -0.5, 0.4], "rotation": [0, 0.3826834, 0, 0.9238795], "scale": [0.1, 1, 0.1]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/cylinder", "material": "builtin:/material/default"}}}}
{"call": "entity.create", "params": {"name": "Leg 2", "parent": "/Table", "components": {"illusion.Transform": {}, "illusion.LocalTransform": {"position": [0.4, -0.5, 0.4], "scale": [0.1, 1, 0.1]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/cylinder", "material": "builtin:/material/default"}}}}
{"call": "entity.create", "params": {"name": "Crate", "components": {"illusion.Transform": {"position": [2, 4, 0]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/cube", "material": "builtin:/material/default"}, "illusion.RigidBody": {"mass": 20, "friction": 0.8, "restitution": 0.3, "linearDamping": 0.1, "angularDamping": 0.2, "gravityFactor": 0.5, "layer": 1, "allowSleeping": false, "continuousCollision": true}, "illusion.Collider": {"halfExtents": [0.5, 0.5, 0.5], "offset": [0, 0.01, 0]}}}}
{"call": "entity.create", "params": {"name": "Ball", "components": {"illusion.Transform": {"position": [-2, 5, 0]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/sphere", "material": "builtin:/material/default"}, "illusion.RigidBody": {}, "illusion.Collider": {"shape": "Sphere", "radius": 0.5}}}}
{"call": "entity.create", "params": {"name": "Pill", "components": {"illusion.Transform": {"position": [-3, 5, 2]}, "illusion.RigidBody": {}, "illusion.Collider": {"shape": "Capsule", "radius": 0.3, "halfHeight": 0.6, "rotation": [0, 0, 0.7071068, 0.7071068]}}}}
{"call": "entity.create", "params": {"name": "Drum", "components": {"illusion.Transform": {"position": [-4, 5, -1]}, "illusion.RigidBody": {}, "illusion.Collider": {"shape": "Cylinder", "radius": 0.4, "halfHeight": 0.4}}}}
{"call": "entity.create", "params": {"name": "Rock", "components": {"illusion.Transform": {"position": [4, 6, 2]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/cube", "material": "builtin:/material/default"}, "illusion.RigidBody": {}, "illusion.Collider": {"shape": "ConvexHull", "mesh": "builtin:/mesh/cube"}}}}
{"call": "entity.create", "params": {"name": "Platform", "components": {"illusion.Transform": {"position": [5, 1, -2]}, "illusion.RigidBody": {"motionType": "Kinematic"}, "illusion.Collider": {"halfExtents": [1.5, 0.1, 1.5]}}}}
{"call": "entity.create", "params": {"name": "Trigger", "components": {"illusion.Transform": {"position": [0, 1, 3]}, "illusion.RigidBody": {"motionType": "Static", "sensor": true}, "illusion.Collider": {"halfExtents": [1, 1, 1]}}}}
{"call": "entity.create", "params": {"name": "Player", "components": {"illusion.Transform": {"position": [0, 0.1, 5]}, "illusion.CharacterController": {"radius": 0.4, "height": 1.7, "maxSlope": 0.7, "stepHeight": 0.3, "mass": 80, "maxPushForce": 150, "gravityFactor": 1.2, "layer": 2}}}}
{"call": "entity.create", "params": {"name": "Door Frame", "components": {"illusion.Transform": {"position": [8, 1, 0]}, "illusion.RigidBody": {"motionType": "Static"}, "illusion.Collider": {"halfExtents": [0.1, 1, 0.1]}}}, "capture": {"frame": "/entity/id"}}
{"call": "entity.create", "params": {"name": "Door", "components": {"illusion.Transform": {"position": [8.6, 1, 0]}, "illusion.RigidBody": {}, "illusion.Collider": {"halfExtents": [0.5, 1, 0.05]}}}}
{"call": "component.add", "params": {"entity": "/Door", "type": "illusion.Joint", "value": {"type": "Hinge", "connected": "${frame}", "anchor": [-0.5, 0, 0], "connectedAnchor": [0.1, 0, 0], "axis": [0, 1, 0], "limited": true, "minLimit": -1.5, "maxLimit": 1.5, "motorSpeed": 0.5, "motorMaxForce": 10, "breakForce": 500}}}
{"call": "entity.create", "params": {"name": "Weld", "components": {"illusion.Transform": {"position": [8, 3, 0]}, "illusion.RigidBody": {}, "illusion.Collider": {}}}}
{"call": "component.add", "params": {"entity": "/Weld", "type": "illusion.Joint", "value": {"type": "Fixed", "connected": "${frame}"}}}
{"call": "entity.create", "params": {"name": "Pendulum", "components": {"illusion.Transform": {"position": [10, 3, 0]}, "illusion.RigidBody": {}, "illusion.Collider": {"shape": "Sphere", "radius": 0.3}}}, "capture": {"pendulum": "/entity/id"}}
{"call": "component.add", "params": {"entity": "/Pendulum", "type": "illusion.Joint", "value": {"type": "Point", "anchor": [0, 1, 0]}}}
{"call": "entity.create", "params": {"name": "Drawer", "components": {"illusion.Transform": {"position": [12, 1, 0]}, "illusion.RigidBody": {}, "illusion.Collider": {"halfExtents": [0.3, 0.1, 0.3]}}}}
{"call": "component.add", "params": {"entity": "/Drawer", "type": "illusion.Joint", "value": {"type": "Slider", "axis": [0, 0, 1], "limited": true, "maxLimit": 0.5}}}
{"call": "entity.create", "params": {"name": "Rope", "components": {"illusion.Transform": {"position": [14, 3, 0]}, "illusion.RigidBody": {}, "illusion.Collider": {"shape": "Sphere", "radius": 0.2}}}}
{"call": "component.add", "params": {"entity": "/Rope", "type": "illusion.Joint", "value": {"type": "Distance", "connected": "${pendulum}", "minLimit": 1, "maxLimit": 2}}}
{"call": "entity.create", "params": {"name": "Radio", "components": {"illusion.Transform": {"position": [3, 1, 3]}, "illusion.AudioSource": {"clip": "assets:/audio/tone.wav", "bus": "Music", "volume": 0.5, "pitch": 1.1, "pan": -0.3, "loop": true, "playOnStart": false, "spatial": false, "stream": true, "attenuation": "Linear", "minDistance": 2, "maxDistance": 50, "rolloff": 0.8, "dopplerFactor": 0.5, "priority": 200, "lowPassCutoff": 8000, "reverbSend": 0.3, "coneInnerAngle": 1, "coneOuterAngle": 2, "coneOuterVolume": 0.25}}}}
{"call": "entity.create", "params": {"name": "Wind", "components": {"illusion.Transform": {}, "illusion.AudioSource": {"clip": "assets:/audio/tone.wav", "bus": "Ambience", "attenuation": "None", "loop": true}}}}
{"call": "entity.create", "params": {"name": "Voice", "components": {"illusion.Transform": {"position": [-3, 1, 3]}, "illusion.AudioSource": {"clip": "assets:/audio/tone.wav", "bus": "Dialogue", "attenuation": "Exponential", "playOnStart": false}}}}
{"call": "entity.create", "params": {"name": "Click", "components": {"illusion.Transform": {}, "illusion.AudioSource": {"clip": "assets:/audio/tone.wav", "bus": "Ui", "spatial": false, "playOnStart": false}}}}
{"call": "entity.create", "params": {"name": "Lantern", "components": {"illusion.Transform": {"position": [-5, 0, 4]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/cylinder", "material": "assets:/materials/brass.material"}}}}
{"call": "entity.create", "params": {"name": "Flame", "parent": "/Lantern", "components": {"illusion.Transform": {}, "illusion.LocalTransform": {"position": [0, 0.8, 0]}, "illusion.PointLight": {"color": [1, 0.6, 0.2], "intensity": 8, "range": 4}}}}
{"call": "prefab.create", "params": {"entity": "/Lantern", "path": "assets:/prefabs/lantern.prefab"}}
{"call": "prefab.instantiate", "params": {"path": "assets:/prefabs/lantern.prefab"}, "capture": {"lantern": "/root/id"}}
{"call": "entity.rename", "params": {"entity": "${lantern}", "name": "Lantern 2"}}
{"call": "transform.set", "params": {"entities": ["/Lantern 2"], "position": [-7, 0, 4]}}
{"call": "component.set", "params": {"entity": "/Lantern 2/Flame", "type": "illusion.PointLight", "value": {"color": [0.4, 0.8, 1], "intensity": 12}}}
{"call": "scene.save_as", "params": {"path": "assets:/scenes/everything.scene", "overwrite": true}}

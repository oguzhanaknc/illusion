{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_CONFIGURATION_TYPES": "Debug;Release;RelWithDebInfo"
      }
    },
    {
      "name": "ci",
      "hidden": true,
      "cacheVariables": {
        "ILLUSION_WARNINGS_AS_ERRORS": "ON",
        "ILLUSION_ENABLE_ASSERTS": "ON"
      }
    },
    {
      "name": "windows",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "linux",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos",
      "hidden": true,
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "windows-msvc",
      "displayName": "Windows / MSVC",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "windows-clang",
      "displayName": "Windows / clang-cl",
      "inherits": "windows",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux / GCC",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "linux-clang",
      "displayName": "Linux / Clang",
      "inherits": "linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "macos-clang",
      "displayName": "macOS / AppleClang",
      "inherits": "macos",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "linux-clang-asan",
      "displayName": "Linux / Clang / ASan+UBSan",
      "inherits": "linux-clang",
      "cacheVariables": {
        "ILLUSION_SANITIZER": "address",
        "ILLUSION_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "linux-clang-tsan",
      "displayName": "Linux / Clang / TSan",
      "inherits": "linux-clang",
      "cacheVariables": {
        "ILLUSION_SANITIZER": "thread",
        "ILLUSION_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "windows-msvc-profile",
      "displayName": "Windows / MSVC / Tracy",
      "inherits": "windows-msvc",
      "cacheVariables": {
        "ILLUSION_PROFILING": "ON"
      }
    },
    {
      "name": "linux-clang-profile",
      "displayName": "Linux / Clang / Tracy",
      "inherits": "linux-clang",
      "cacheVariables": {
        "ILLUSION_PROFILING": "ON"
      }
    },
    {
      "name": "macos-clang-profile",
      "displayName": "macOS / AppleClang / Tracy",
      "inherits": "macos-clang",
      "cacheVariables": {
        "ILLUSION_PROFILING": "ON"
      }
    },
    {
      "name": "ci-windows-msvc",
      "displayName": "CI: windows-msvc",
      "inherits": [
        "ci",
        "windows-msvc"
      ]
    },
    {
      "name": "ci-windows-clang",

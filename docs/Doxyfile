# Doxygen configuration for the illusion API reference. Run from the repository root:
#     doxygen docs/Doxyfile
# Only public headers are documented. Undocumented public declarations are errors.

PROJECT_NAME           = "illusion"
PROJECT_BRIEF          = "3D game engine"
OUTPUT_DIRECTORY       = build
CREATE_SUBDIRS         = NO

INPUT                  = engine/core/include engine/text/include engine/platform/include engine/input/include engine/assets/include engine/physics/include engine/audio/include engine/render/include engine/modules/include editor/core/include editor/ui/include docs/api-mainpage.md
FILE_PATTERNS          = *.hpp *.md
RECURSIVE              = YES
USE_MDFILE_AS_MAINPAGE = docs/api-mainpage.md
STRIP_FROM_PATH        = engine/core/include engine/text/include engine/platform/include engine/input/include engine/assets/include engine/physics/include engine/audio/include engine/render/include engine/modules/include
STRIP_FROM_INC_PATH    = engine/core/include engine/text/include engine/platform/include engine/input/include engine/assets/include engine/physics/include engine/audio/include engine/render/include engine/modules/include
FULL_PATH_NAMES        = YES

EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_ANON_NSPACES   = NO
HIDE_UNDOC_CLASSES     = NO
EXCLUDE_SYMBOLS        = illusion::detail illusion::detail::* *::Impl
JAVADOC_AUTOBRIEF      = YES
MARKDOWN_SUPPORT       = YES
BUILTIN_STL_SUPPORT    = YES
INLINE_INHERITED_MEMB  = NO
SORT_MEMBER_DOCS       = NO

ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
PREDEFINED             = ILLUSION_ENABLE_ASSERTS=1 \
                         ILL_FORCEINLINE=inline \
                         ILL_NOINLINE= \
                         "requires(x)="

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = FAIL_ON_WARNINGS

GENERATE_HTML          = YES
HTML_OUTPUT            = api
GENERATE_LATEX         = NO
GENERATE_TREEVIEW      = YES
HAVE_DOT               = NO
SEARCHENGINE           = YES

# XML output (build/xml) feeds tools that check API coverage.
GENERATE_XML           = YES
XML_OUTPUT             = xml

{"comment": "Takes the screenshot of the animation manual (docs/content/en/images/editor/animation-preview.png): the tech demo's creature selected, its Animator's Preview section in the Inspector and the Skeletons visualiser. Runs in a headless editor with a GPU on a copy of samples/techdemo without the downloaded assets (CTest docs.screenshots.animation); the scene is built here from committed files only."}
{"call": "editor.wait", "params": {"frames": 10}}
{"call": "scene.new", "params": {"discardChanges": true}}
{"call": "entity.create", "params": {"name": "Sky", "components": {"illusion.Transform": {}, "illusion.SkyLight": {"environment": "builtin:/sky/procedural", "intensity": 0.8}, "illusion.ProceduralSky": {"zenith": [0.2, 0.4, 0.85], "horizon": [0.85, 0.9, 0.95], "ground": [0.3, 0.25, 0.2], "sunDirection": [0.4, 0.7, -0.6], "sunRadiance": [20, 18, 15], "sunAngularRadius": 0.03, "resolution": 256}}}}
{"call": "material.create", "params": {"path": "assets:/materials/preview_ground.material", "value": {"material": {"name": "Preview Ground", "baseColorFactor": [0.3, 0.34, 0.3, 1], "roughnessFactor": 0.9}}, "overwrite": true}}
{"call": "entity.create", "params": {"name": "Ground", "components": {"illusion.Transform": {"scale": [20, 1, 20]}, "illusion.MeshRenderer": {"mesh": "builtin:/mesh/plane", "material": "assets:/materials/preview_ground.material", "layers": 3}}}}
{"call": "entity.create", "params": {"name": "Creature", "components": {"illusion.Transform": {"rotation": [0.0, 1.0, 0.0, 0.0]}, "illusion.MeshRenderer": {"mesh": "assets:/models/creature.gltf#mesh/0", "material": "assets:/materials/creature_fur.material"}, "illusion.Animator": {"skeleton": "assets:/models/creature.gltf#skin/0", "graph": "assets:/animations/creature.animgraph", "time": 0.4}}}}
{"call": "ui.layout_apply", "params": {"name": "default"}}
{"call": "selection.set", "params": {"entities": ["/Creature"]}}
{"call": "gizmo.set_tool", "params": {"tool": "select"}}
{"call": "viewport.set_overlays", "params": {"viewport": "scene", "visualisers": {"skeleton": true}}}
{"call": "viewport.camera_set", "params": {"viewport": "scene", "pivot": [0, 0.5, 0], "eye": [1.7, 0.95, 2.3], "animate": false}}
{"call": "editor.wait", "params": {"frames": 60}}
{"call": "editor.screenshot", "params": {"width": 1280, "height": 720}, "requires": "gpu", "image": {"golden": "../content/en/images/editor/animation-preview.png", "channelTolerance": 8, "maxDifferent": 0.03, "notUniform": true}}

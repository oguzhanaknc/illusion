# Writes the ```cpp code blocks of a Markdown page, in order, to one C++ source file, so that the code of a
# tutorial is compiled by the build (tests/CMakeLists.txt):
#   cmake -D SOURCE=<page.md> -D OUTPUT=<file.cpp> -P ExtractCppBlocks.cmake
# CMake lists split at ';' and treat brackets specially, so those characters are replaced while the page is
# split into lines and restored in the output.
file(READ "${SOURCE}" text)
string(REPLACE "\r\n" "\n" text "${text}")
string(REPLACE ";" "<ill-semicolon>" text "${text}")
string(REPLACE "[" "<ill-open>" text "${text}")
string(REPLACE "]" "<ill-close>" text "${text}")
string(REPLACE "\n" ";" lines "${text}")
set(code "// Generated from ${SOURCE} by cmake/ExtractCppBlocks.cmake: edit the page, not this file.\n")
set(inside FALSE)
set(blocks 0)
foreach(line IN LISTS lines)
    if(inside)
        if(line STREQUAL "```")
            set(inside FALSE)
        else()
            string(APPEND code "${line}\n")
        endif()
    elseif(line STREQUAL "```cpp")
        set(inside TRUE)
        math(EXPR blocks "${blocks} + 1")
    endif()
endforeach()
if(blocks EQUAL 0 OR inside)
    message(FATAL_ERROR "${SOURCE}: no complete ```cpp block")
endif()
string(REPLACE "<ill-semicolon>" ";" code "${code}")
string(REPLACE "<ill-open>" "[" code "${code}")
string(REPLACE "<ill-close>" "]" code "${code}")
file(WRITE "${OUTPUT}.tmp" "${code}")
file(COPY_FILE "${OUTPUT}.tmp" "${OUTPUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUTPUT}.tmp")

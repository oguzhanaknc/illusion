# Icon constants generated from a Material Symbols ".codepoints" file (lines of "name hex").
#
#   illusion_add_icon_header(<target> CODEPOINTS <file> NAMESPACE <ns> HEADER <path>)
#
# Generates <path> (e.g. illusion/editor/ui/Icons.hpp) with an Icon constant per name, so that an unknown
# icon name is a compile error ("account_tree" -> kAccountTree), and a source file with the sorted name
# table behind allIcons() and findIcon() (illusion/editor/ui/Icon.hpp).
#
# The same file runs in script mode (cmake -P) to do the generation at build time.

if(CMAKE_SCRIPT_MODE_FILE)
    # Script mode starts without the project's policies.
    cmake_policy(VERSION 3.28)
    foreach(required CODEPOINTS NAMESPACE HEADER CPP INCLUDE)
        if(NOT DEFINED ${required})
            message(FATAL_ERROR "IllusionIcons.cmake: -D${required}=... is required")
        endif()
    endforeach()

    file(STRINGS "${CODEPOINTS}" lines)
    get_filename_component(source_name "${CODEPOINTS}" NAME)
    set(constants "")
    set(entries "")
    list(SORT lines)
    foreach(line IN LISTS lines)
        if(NOT line MATCHES "^([a-z0-9_]+) ([0-9a-f]+)$")
            message(FATAL_ERROR "${CODEPOINTS}: malformed line '${line}'")
        endif()
        set(name "${CMAKE_MATCH_1}")
        set(hex "${CMAKE_MATCH_2}")

        # snake_case -> kPascalCase
        string(REPLACE "_" ";" parts "${name}")
        set(identifier "k")
        foreach(part IN LISTS parts)
            string(SUBSTRING "${part}" 0 1 first)
            string(SUBSTRING "${part}" 1 -1 rest)
            string(TOUPPER "${first}" first)
            string(APPEND identifier "${first}${rest}")
        endforeach()
        if(DEFINED seen_${identifier})
            message(FATAL_ERROR "${CODEPOINTS}: '${name}' gives the identifier ${identifier} twice")
        endif()
        set(seen_${identifier} TRUE)

        # UTF-8 encoding of the code point, as \x escapes.
        math(EXPR cp "0x${hex}")
        if(cp LESS 0x80)
            set(bytes "${cp}")
        elseif(cp LESS 0x800)
            math(EXPR b0 "0xC0 | (${cp} >> 6)")
            math(EXPR b1 "0x80 | (${cp} & 0x3F)")
            set(bytes "${b0};${b1}")
        elseif(cp LESS 0x10000)
            math(EXPR b0 "0xE0 | (${cp} >> 12)")
            math(EXPR b1 "0x80 | ((${cp} >> 6) & 0x3F)")
            math(EXPR b2 "0x80 | (${cp} & 0x3F)")
            set(bytes "${b0};${b1};${b2}")
        else()
            math(EXPR b0 "0xF0 | (${cp} >> 18)")
            math(EXPR b1 "0x80 | ((${cp} >> 12) & 0x3F)")
            math(EXPR b2 "0x80 | ((${cp} >> 6) & 0x3F)")
            math(EXPR b3 "0x80 | (${cp} & 0x3F)")
            set(bytes "${b0};${b1};${b2};${b3}")
        endif()
        set(utf8 "")
        foreach(byte IN LISTS bytes)
            math(EXPR byte_hex "${byte}" OUTPUT_FORMAT HEXADECIMAL)
            string(SUBSTRING "${byte_hex}" 2 -1 byte_hex)
            string(TOUPPER "${byte_hex}" byte_hex)
            string(APPEND utf8 "\\x${byte_hex}")
        endforeach()
        string(TOUPPER "${hex}" hex_upper)

        string(APPEND constants "/// `${name}` (U+${hex_upper})\n")
        string(APPEND constants "inline constexpr ::illusion::editor::ui::Icon ${identifier}{0x${hex_upper}, \"${utf8}\"};\n")
        string(APPEND entries "    {\"${name}\", ${identifier}},\n")
    endforeach()
    list(LENGTH lines count)

    set(header_text "// Generated by cmake/IllusionIcons.cmake from ${source_name}. Do not edit.\n#pragma once\n\n")
    string(APPEND header_text "#include <illusion/editor/ui/Icon.hpp>\n\nnamespace ${NAMESPACE}\n{\n\n${constants}\n")
    string(APPEND header_text "} // namespace ${NAMESPACE}\n")

    set(cpp_text "// Generated by cmake/IllusionIcons.cmake from ${source_name}. Do not edit.\n")
    string(APPEND cpp_text "#include <${INCLUDE}>\n\n#include <array>\n\nnamespace illusion::editor::ui\n{\n\n")
    string(APPEND cpp_text "namespace\n{\n\nusing namespace ${NAMESPACE};\n\n")
    string(APPEND cpp_text "// Sorted by name.\nconstexpr std::array<IconEntry, ${count}> kIcons = {{\n${entries}}};\n\n")
    string(APPEND cpp_text "} // namespace\n\nstd::span<const IconEntry> allIcons() noexcept\n{\n    return kIcons;\n}\n\n")
    string(APPEND cpp_text "} // namespace illusion::editor::ui\n")

    foreach(kind HEADER CPP)
        set(text "${header_text}")
        if(kind STREQUAL "CPP")
            set(text "${cpp_text}")
        endif()
        set(old "")
        if(EXISTS "${${kind}}")
            file(READ "${${kind}}" old)
        endif()
        if(NOT old STREQUAL text)
            file(WRITE "${${kind}}" "${text}")
        endif()
    endforeach()
    return()
endif()

include_guard(GLOBAL)

set(ILLUSION_ICONS_SCRIPT "${CMAKE_CURRENT_LIST_FILE}")

function(illusion_add_icon_header target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "CODEPOINTS;NAMESPACE;HEADER" "")
    if(arg_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "illusion_add_icon_header: unknown arguments ${arg_UNPARSED_ARGUMENTS}")
    endif()
    foreach(required CODEPOINTS NAMESPACE HEADER)
        if(NOT arg_${required})
            message(FATAL_ERROR "illusion_add_icon_header: ${required} is required")
        endif()
    endforeach()

    set(generated_dir ${CMAKE_CURRENT_BINARY_DIR}/generated/icons)
    set(header ${generated_dir}/${arg_HEADER})
    get_filename_component(stem "${arg_HEADER}" NAME_WE)
    set(cpp ${generated_dir}/${stem}Table.cpp)

    add_custom_command(
        OUTPUT ${header} ${cpp}
        COMMAND ${CMAKE_COMMAND} -DCODEPOINTS=${arg_CODEPOINTS} -DNAMESPACE=${arg_NAMESPACE} -DHEADER=${header}
                -DCPP=${cpp} -DINCLUDE=${arg_HEADER} -P ${ILLUSION_ICONS_SCRIPT}
        DEPENDS ${arg_CODEPOINTS} ${ILLUSION_ICONS_SCRIPT}
        COMMENT "Generating icon constants ${arg_HEADER}"
        VERBATIM)

    target_sources(${target} PRIVATE ${header} ${cpp})
    target_include_directories(${target} PUBLIC $<BUILD_INTERFACE:${generated_dir}>)
endfunction()

# Build-time shader compilation.
#
# illusion_add_shaders(<target>
#     NAMESPACE <c++ namespace>          e.g. illusion::shaders
#     HEADER <include path>              e.g. illusion/render/BuiltinShaders.hpp
#     SHADERS <function> <source.slang> <entry point> <stage>
#             [<function> <source.slang> <entry point> <stage> ...])
#
# Each shader entry point is compiled with Slang to SPIR-V and embedded in <target>. The generated
# header declares one function per shader:
#     std::span<const std::byte> <function>() noexcept;
# returning the SPIR-V bytecode (entry point renamed to "main"). Shader compile errors and warnings fail
# the build.

include_guard(GLOBAL)

set(ILLUSION_SHADERS_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/EmbedShader.cmake")
# The engine's shader library: what material shaders (ADR 0063) are compiled against.
set(ILLUSION_SHADER_LIBRARY_DIR "${CMAKE_CURRENT_LIST_DIR}/../engine/render/shaders")
cmake_path(NORMAL_PATH ILLUSION_SHADER_LIBRARY_DIR)

# ShaderCompiler (engine/assets) repeats these flags, without -warnings-as-errors, for material shaders.
# Register shifts match NVRHI's default Vulkan binding offsets (t: 0, s: 128, b: 256, u: 384), so
# HLSL-style registers map to the bindings NVRHI creates. Matrices are column-major like glm, so
# mul(matrix, vector) in shaders equals matrix * vector in C++.
set(ILLUSION_SHADER_FLAGS
    -fvk-t-shift 0 all -fvk-s-shift 128 all -fvk-b-shift 256 all -fvk-u-shift 384 all
    -matrix-layout-column-major -warnings-as-errors all)

function(illusion_add_shaders target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "NAMESPACE;HEADER" "SHADERS")
    if(NOT arg_NAMESPACE OR NOT arg_HEADER OR NOT arg_SHADERS)
        message(FATAL_ERROR "illusion_add_shaders: NAMESPACE, HEADER and SHADERS are required")
    endif()
    list(LENGTH arg_SHADERS count)
    math(EXPR remainder "${count} % 4")
    if(NOT remainder EQUAL 0)
        message(FATAL_ERROR "illusion_add_shaders: SHADERS takes groups of <function> <source> <entry> <stage>")
    endif()

    illusion_require_dependency(slang)

    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/shaders_${target}")
    set(header_path "${out_dir}/include/${arg_HEADER}")
    set(declarations "")
    set(sources "")

    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last} 4)
        math(EXPR i_source "${index} + 1")
        math(EXPR i_entry "${index} + 2")
        math(EXPR i_stage "${index} + 3")
        list(GET arg_SHADERS ${index} function)
        list(GET arg_SHADERS ${i_source} source)
        list(GET arg_SHADERS ${i_entry} entry)
        list(GET arg_SHADERS ${i_stage} stage)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
        cmake_path(GET source FILENAME source_name)

        # Per-configuration outputs: multi-config generators may build several configurations at once.
        set(spv "${out_dir}/$<CONFIG>/${function}.spv")
        set(cpp "${out_dir}/$<CONFIG>/${function}.cpp")
        add_custom_command(
            OUTPUT "${spv}"
            COMMAND "${ILLUSION_SLANGC}" "${source}" -target spirv -entry ${entry} -stage ${stage}
                    ${ILLUSION_SHADER_FLAGS} -depfile "${spv}.d" -o "${spv}"
            DEPENDS "${source}"
            DEPFILE "${spv}.d"
            COMMENT "Compiling shader ${source_name}:${entry} (${stage})"
            VERBATIM)
        add_custom_command(
            OUTPUT "${cpp}"
            COMMAND "${CMAKE_COMMAND}" -DINPUT=${spv} -DOUTPUT=${cpp} -DFUNCTION=${function}
                    -DNAMESPACE=${arg_NAMESPACE} -DHEADER=${arg_HEADER} -P "${ILLUSION_SHADERS_EMBED_SCRIPT}"
            DEPENDS "${spv}" "${ILLUSION_SHADERS_EMBED_SCRIPT}"
            COMMENT "Embedding shader ${function}"
            VERBATIM)
        list(APPEND sources "${cpp}")
        string(APPEND declarations
            "/// SPIR-V of entry point `${entry}` (${stage}) in ${source_name}.\n"
            "[[nodiscard]] std::span<const std::byte> ${function}() noexcept;\n\n")
    endforeach()

    file(CONFIGURE OUTPUT "${header_path}" CONTENT [[
#pragma once

// Generated by illusion_add_shaders(); do not edit.

#include <cstddef>
#include <span>

namespace @arg_NAMESPACE@
{

@declarations@} // namespace @arg_NAMESPACE@
]] @ONLY)

    target_sources(${target} PRIVATE ${sources})
    target_include_directories(${target} PUBLIC "$<BUILD_INTERFACE:${out_dir}/include>")
endfunction()

# Material shaders (ADR 0063) compiled at build time by illusion_shaderc and embedded as cooked ShaderAssets.
#
# illusion_add_material_shaders(<target>
#     NAMESPACE <c++ namespace>
#     SHADERS <function> <source.shader> <virtual path> [<function> <source.shader> <virtual path> ...])
#
# Each shader defines `std::span<const std::byte> <namespace>::<function>() noexcept` in <target>, the bytes of
# serializeShader() for deserializeShader(); declare it where it is used. Compile errors fail the build.
function(illusion_add_material_shaders target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "NAMESPACE" "SHADERS")
    list(LENGTH arg_SHADERS count)
    math(EXPR remainder "${count} % 3")
    if(NOT arg_NAMESPACE OR count EQUAL 0 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "illusion_add_material_shaders: NAMESPACE and SHADERS <function> <source> <path> are required")
    endif()
    illusion_require_dependency(slang)
    file(GLOB_RECURSE library CONFIGURE_DEPENDS "${ILLUSION_SHADER_LIBRARY_DIR}/*.slang")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last} 3)
        math(EXPR i_source "${index} + 1")
        math(EXPR i_path "${index} + 2")
        list(GET arg_SHADERS ${index} function)
        list(GET arg_SHADERS ${i_source} source)
        list(GET arg_SHADERS ${i_path} virtual_path)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
        set(cpp "${CMAKE_CURRENT_BINARY_DIR}/material_shaders_${target}/$<CONFIG>/${function}.cpp")
        add_custom_command(
            OUTPUT "${cpp}"
            COMMAND illusion_shaderc "${ILLUSION_SLANGC}" "${ILLUSION_SHADER_LIBRARY_DIR}" "${source}"
                    "${virtual_path}" "${arg_NAMESPACE}" "${function}" "${cpp}"
            DEPENDS illusion_shaderc "${source}" ${library}
            COMMENT "Compiling material shader ${virtual_path}"
            VERBATIM)
        target_sources(${target} PRIVATE "${cpp}")
    endforeach()
endfunction()

# Installs the pinned slangc (without the parts that only CPU targets need) in slang/ and the shader library in
# share/illusion/shaders under the prefix, with the install component <component>: the cooker (illusion_pack)
# and the editor compile material shaders with them (ADR 0063).
function(illusion_install_shader_compiler component)
    illusion_require_dependency(slang)
    cmake_path(GET ILLUSION_SLANGC PARENT_PATH slang_bin)
    cmake_path(GET slang_bin PARENT_PATH slang_root)
    install(DIRECTORY "${slang_bin}/" DESTINATION slang/bin COMPONENT ${component} USE_SOURCE_PERMISSIONS
        PATTERN "*slang-llvm*" EXCLUDE
        PATTERN "gfx*" EXCLUDE
        PATTERN "slangd*" EXCLUDE
        PATTERN "slangi*" EXCLUDE
        PATTERN "*.lib" EXCLUDE
        PATTERN "*.pdb" EXCLUDE)
    if(IS_DIRECTORY "${slang_root}/lib")
        install(DIRECTORY "${slang_root}/lib/" DESTINATION slang/lib COMPONENT ${component} USE_SOURCE_PERMISSIONS
            FILES_MATCHING PATTERN "*.so*" PATTERN "*.dylib" PATTERN "*slang-standard-module*"
            PATTERN "*slang-llvm*" EXCLUDE
            PATTERN "*gfx*" EXCLUDE
            PATTERN "cmake" EXCLUDE)
    endif()
    foreach(licence LICENSE LICENSES)
        if(IS_DIRECTORY "${slang_root}/${licence}")
            install(DIRECTORY "${slang_root}/${licence}" DESTINATION slang COMPONENT ${component})
        elseif(EXISTS "${slang_root}/${licence}")
            install(FILES "${slang_root}/${licence}" DESTINATION slang COMPONENT ${component})
        endif()
    endforeach()
    install(DIRECTORY "${ILLUSION_SHADER_LIBRARY_DIR}/" DESTINATION share/illusion/shaders COMPONENT ${component}
        FILES_MATCHING PATTERN "*.slang")
endfunction()

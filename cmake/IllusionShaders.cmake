# Build-time shader compilation.
#
# illusion_add_shaders(<target>
#     NAMESPACE <c++ namespace>          e.g. illusion::shaders
#     HEADER <include path>              e.g. illusion/render/BuiltinShaders.hpp
#     SHADERS <function> <source.slang> <entry point> <stage>
#             [<function> <source.slang> <entry point> <stage> ...])
#
# Each shader entry point is compiled with Slang to SPIR-V and embedded in <target>. The generated
# header declares one function per shader:
#     std::span<const std::byte> <function>() noexcept;
# returning the SPIR-V bytecode (entry point renamed to "main"). Shader compile errors fail the build.

include_guard(GLOBAL)

set(ILLUSION_SHADERS_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/EmbedShader.cmake")

function(illusion_add_shaders target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "" "NAMESPACE;HEADER" "SHADERS")
    if(NOT arg_NAMESPACE OR NOT arg_HEADER OR NOT arg_SHADERS)
        message(FATAL_ERROR "illusion_add_shaders: NAMESPACE, HEADER and SHADERS are required")
    endif()
    list(LENGTH arg_SHADERS count)
    math(EXPR remainder "${count} % 4")
    if(NOT remainder EQUAL 0)
        message(FATAL_ERROR "illusion_add_shaders: SHADERS takes groups of <function> <source> <entry> <stage>")
    endif()

    illusion_require_dependency(slang)

    set(out_dir "${CMAKE_CURRENT_BINARY_DIR}/shaders_${target}")
    set(header_path "${out_dir}/include/${arg_HEADER}")
    set(declarations "")
    set(sources "")

    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last} 4)
        math(EXPR i_source "${index} + 1")
        math(EXPR i_entry "${index} + 2")
        math(EXPR i_stage "${index} + 3")
        list(GET arg_SHADERS ${index} function)
        list(GET arg_SHADERS ${i_source} source)
        list(GET arg_SHADERS ${i_entry} entry)
        list(GET arg_SHADERS ${i_stage} stage)
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE)
        cmake_path(GET source FILENAME source_name)

        # Per-configuration outputs: multi-config generators may build several configurations at once.
        set(spv "${out_dir}/$<CONFIG>/${function}.spv")
        set(cpp "${out_dir}/$<CONFIG>/${function}.cpp")
        add_custom_command(
            OUTPUT "${spv}"
            COMMAND "${ILLUSION_SLANGC}" "${source}" -target spirv -entry ${entry} -stage ${stage}
                    -warnings-as-errors all -depfile "${spv}.d" -o "${spv}"
            DEPENDS "${source}"
            DEPFILE "${spv}.d"
            COMMENT "Compiling shader ${source_name}:${entry} (${stage})"
            VERBATIM)
        add_custom_command(
            OUTPUT "${cpp}"
            COMMAND "${CMAKE_COMMAND}" -DINPUT=${spv} -DOUTPUT=${cpp} -DFUNCTION=${function}
                    -DNAMESPACE=${arg_NAMESPACE} -DHEADER=${arg_HEADER} -P "${ILLUSION_SHADERS_EMBED_SCRIPT}"
            DEPENDS "${spv}" "${ILLUSION_SHADERS_EMBED_SCRIPT}"
            COMMENT "Embedding shader ${function}"
            VERBATIM)
        list(APPEND sources "${cpp}")
        string(APPEND declarations
            "/// SPIR-V of entry point `${entry}` (${stage}) in ${source_name}.\n"
            "[[nodiscard]] std::span<const std::byte> ${function}() noexcept;\n\n")
    endforeach()

    file(CONFIGURE OUTPUT "${header_path}" CONTENT [[
#pragma once

// Generated by illusion_add_shaders(); do not edit.

#include <cstddef>
#include <span>

namespace @arg_NAMESPACE@
{

@declarations@} // namespace @arg_NAMESPACE@
]] @ONLY)

    target_sources(${target} PRIVATE ${sources})
    target_include_directories(${target} PUBLIC "$<BUILD_INTERFACE:${out_dir}/include>")
endfunction()
